{
  "name": "kanji-quiz-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ios": "vite build --outDir dist-ios",
    "ios:assets": "node scripts/ios-assets.mjs",
    "ios:sync": "node scripts/check-ios-output.mjs && npm run build:ios && cap sync ios && npm run ios:assets",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "vite build && electron-builder && node create-desktop-shortcut.js"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@fontsource/klee-one": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "hanzi-writer": "^3.7.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "sharp": "0.35.4",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^2.0.0",
    "yaml": "2.9.1"
  },
  "build": {
    "appId": "com.japaneserevision.app",
    "productName": "Japanese Revision",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
